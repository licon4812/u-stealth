<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UStealth.WinUI.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UStealth.WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:UStealth.WinUI.Models"
    xmlns:tableView="using:WinUI.TableView"
    d:DataContext="{d:DesignInstance Type=models:DriveInfoModel}"
    mc:Ignorable="d">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <ProgressRing x:Name="ProgressRing" IsActive="False" />
            <Button HorizontalAlignment="Right" Click="RefreshButton_Click">
                <FontIcon Glyph="&#xE72C;" />
            </Button>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="Search here:" />
                <TextBox
                    x:Name="FilterText"
                    Width="600"
                    PlaceholderText="Search by any value from any of the columns"
                    TextChanged="OnSearchTextChanged" />
                <CheckBox
                    Checked="HideDrivesCheckBox_OnChecked"
                    Content="Hide Fixed Drives"
                    IsChecked="{x:Bind AreFixedDrivesHidden}"
                    Unchecked="HideDrivesCheckBox_UnChecked" />
            </StackPanel>
            <tableView:TableView
                x:Name="DrivesTableView"
                Grid.Row="1"
                Margin="0,16,0,0"
                AutoGenerateColumns="False"
                CanFilterColumns="True"
                ItemsSource="{x:Bind Drives}"
                SelectionMode="Single">
                <tableView:TableView.Columns>
                    <tableView:TableViewTemplateColumn Header="System Drive" IsReadOnly="True">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:DriveInfoModel">
                                <CheckBox IsChecked="{x:Bind IsSystemDrive, Mode=OneWay}" />
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn Header="Drive Letter" IsReadOnly="True">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:DriveInfoModel">
                                <TextBlock Text="{x:Bind DriveLetter, Mode=OneWay}" />
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn
                        Width="80"
                        Header="Interface"
                        IsReadOnly="True">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:DriveInfoModel">
                                <TextBlock Text="{x:Bind Interface, Mode=OneWay}" />
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn Header="Volume Label" IsReadOnly="True">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:DriveInfoModel">
                                <TextBlock Text="{x:Bind VolumeLabel, Mode=OneWay}" />
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn Header="Format" IsReadOnly="True">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:DriveInfoModel">
                                <TextBlock Text="{x:Bind Format, Mode=OneWay}" />
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn
                        Width="200"
                        Header="Model"
                        IsReadOnly="True">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:DriveInfoModel">
                                <TextBlock Text="{x:Bind Model, Mode=OneWay}" />
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn Header="Media type" IsReadOnly="True">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:DriveInfoModel">
                                <TextBlock Text="{x:Bind MediaType, Mode=OneWay}" />
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn Header="Size" IsReadOnly="True">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:DriveInfoModel">
                                <TextBlock Text="{x:Bind Size, Mode=OneWay}" />
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                    <tableView:TableViewTemplateColumn x:Name="StatusTemplate" Header="Status">
                        <tableView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:DriveInfoModel">
                                <StackPanel>
                                    <ToggleSwitch
                                        x:Name="StatusToggle"
                                        IsOn="{x:Bind Status, Mode=TwoWay, Converter={StaticResource StatusToIsOnConverter}}"
                                        OffContent="NORMAL"
                                        OnContent="HIDDEN"
                                        Toggled="StatusToggle_OnToggled"
                                        Visibility="{x:Bind Status, Converter={StaticResource StatusToTemplateColumnVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind Status}" Visibility="{x:Bind Status, Converter={StaticResource UnknownStatusVisibilityConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </tableView:TableViewTemplateColumn.CellTemplate>
                    </tableView:TableViewTemplateColumn>
                </tableView:TableView.Columns>
            </tableView:TableView>
        </Grid>

    </Grid>
</Page>
